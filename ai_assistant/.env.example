# Copy this file to .env and fill in your key:  cp .env.example .env
# Never commit the .env file.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=llama-3.1-8b-instant

# Local vLLM server (optional last fallback). Leave empty if you don't run vLLM.
#   running scripts/start_vllm.sh on the host -> http://localhost:8001/v1
#   using docker compose --profile gpu        -> http://vllm:8000/v1
VLLM_BASE_URL=
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Generation parameters
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=2000
# gpt-oss only: low | medium | high
REASONING_EFFORT=low

# RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
# true = use the ONNX INT8 embedding model (run scripts/export_onnx.py first when running locally)
USE_ONNX_EMBEDDINGS=false

# Reliability / performance
MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_LLM_CALLS=5
CACHE_TTL_SECONDS=600
